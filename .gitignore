# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js build output
.next/
/out/

# production
/build
dist/

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
venv/
.venv/
venv_check/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.streanlit/secrets.toml
*.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Generated reports (p2)
reports/

# SQLite dev databases
*.db

# OS generated
Thumbs.db

# Android SDK
android-sdk/

# Android build
android/
.gradle/
local.properties

# Streamlit
.streamlit/secrets.toml

# Sounds (if custom)
stockbot/sounds/*.wav
stockbot/sounds/*.mp3
stockbot/sounds/*.ogg

# Build artifacts
*.exe
*.msi
