# Streamlit Cloud secrets — set these in the dashboard, not in git:
# https://share.streamlit.io → your app → Settings → Secrets
#
# [github_oauth]
# client_id = "your_github_client_id"
# client_secret = "your_github_client_secret"
# redirect_uri = "https://YOUR_APP_NAME.streamlit.app"
#
# [twelvedata]
# api_key = "optional_fallback_data_source"
