# Stock Signal Bot - Environment Configuration
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ─── API Keys ──────────────────────────────────────────────────────

# Alpha Vantage API Key (recommended - free tier: 25 calls/day, 5 calls/min)
# Get a free key at: https://www.alphavantage.co/support/#api-key
# This is now the primary data source for better reliability.
ALPHAVANTAGE_API_KEY=

# Twelve Data API Key (optional fallback data source)
# Get a free key at: https://twelvedata.com/apikey
# Used as fallback if Alpha Vantage fails.
TWELVEDATA_API_KEY=

# ─── Scanning Settings ─────────────────────────────────────────────

# Maximum number of stocks to scan in a single run (default: 100)
MAX_STOCKS_TO_SCAN=100

# Minimum signal score threshold (0-100, default: 30)
# Signals below this score are filtered out in reports
MIN_SIGNAL_SCORE=30

# ─── Output ────────────────────────────────────────────────────────

# Directory for exported reports (default: ./reports)
# OUTPUT_DIR=./reports
